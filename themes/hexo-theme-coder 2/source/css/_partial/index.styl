.home-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 56px 0 18px;
}

.home-hero-avatar {
    width: 96px;
    height: 96px;
}

.home-hero .logopng {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 1px solid #444;
    padding: 6px;
    background-color: #111;
}

.home-hero-copy {
    max-width: 640px;
}

.home-hero-title {
    margin: 0;
    font-size: 42px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    font-family: "KaiTi", "KaiTi_GB2312", "STKaiti", "Kaiti SC", "楷体", serif;
}

.home-hero-subtitle {
    margin: 14px 0 0;
    padding-top: 0;
    font-size: 16px;
    line-height: 1.9;
    color: #bbb;
    font-family: "STXingkai", "FZShuTi", "LiSu", "KaiTi", "STKaiti", "楷体", cursive;
}

.home-index {
    padding-bottom: 24px;
}

.home-layout,
.home-layout-shell {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
}

.home-layout-sidebar {
    position: sticky;
    top: 18px;
    min-width: 0;
}

.home-layout-content,
.home-posts,
.home-posts-panel {
    min-width: 0;
}

.home-load-more-shell {
    padding-top: 26px;
    text-align: center;
}

.home-load-more {
    min-width: 150px;
    padding: 11px 22px;
    border: 1px solid #555;
    border-radius: 999px;
    background-color: #111;
    color: #e7ebf5;
    font: inherit;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
}

.home-load-more:hover {
    border-color: #888;
    background-color: #1a2030;
    transform: translateY(-1px);
}

.home-load-more[hidden] {
    display: none;
}

.home-result-summary {
    margin: 12px 0 0;
    color: #8f9bb3;
    font-size: 12px;
}

.home-posts-empty,
.home-empty {
    padding: 40px 24px;
    border: 1px dashed #555;
    border-radius: 18px;
    color: #8f9bb3;
    background-color: rgba(21, 25, 34, 0.72);
    text-align: center;
}

.home-posts-empty p,
.home-empty p {
    margin: 0;
}

.home-year-title {
    margin-top: 44px;
    margin-bottom: 16px;
    font-size: 26px;
}

.home-year-title:first-child {
    margin-top: 0;
}

.home-year-title p {
    display: flex;
    align-items: center;
    margin: 0;
    color: #fff;
}

.home-year-line {
    display: inline-block;
    width: 38px;
    height: 1px;
    margin-right: 14px;
    background-color: #fff;
}

.home-post-link {
    display: block;
}

.home-post-item {
    height: auto;
    min-height: 0;
    padding: 16px 2px;
    border-bottom: 1px solid #444;
}

.home-post-link:hover .home-post-item {
    border-color: #555;
    transform: translateX(2px);
}

.home-post-name {
    max-width: calc(100% - 120px);
    font-size: 17px;
    color: #e7ebf5;
}

.home-post-time {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #999;
}

.bg_while .home-hero .logopng {
    background-color: #ffffff;
    border-color: #ddd;
}

.bg_while .home-hero-subtitle {
    color: #6b7688;
}

.bg_while .home-posts-empty,
.bg_while .home-empty {
    color: #7a8597;
}

.bg_while .home-posts-empty,
.bg_while .home-empty {
    border-color: #ddd;
    background-color: #ffffff;
}

.bg_while .home-year-title p,
.bg_while .home-post-name {
    color: #000;
}

.bg_while .home-post-item {
    border-color: #ddd;
}

.bg_while .home-post-link:hover .home-post-item {
    border-color: #b8c4db;
}

.bg_while .home-post-time {
    color: #7a8597;
}

.bg_while .home-load-more {
    border-color: #ccd2dc;
    background-color: #fff;
    color: #283345;
}

.bg_while .home-load-more:hover {
    border-color: #9aa6b8;
    background-color: #f4f6fa;
}

.bg_while .home-result-summary {
    color: #7a8597;
}

.bg_while hr {
    border-color: #ddd;
}

.bg_while .jing {
    color: #000;
}

.bg_while .logot .logo_1,
.bg_while .logot .logo_2,
.bg_while .logot .logo_3 {
    color: inherit;
}

.bg_while .titlex {
    color: #000;
}

.bg_while .list {
    color: #4b5565;
}

.bg_while .posttime {
    color: #7a8597;
}

.bg_while .postname {
    color: #000;
}

.bg_while .flink,
.bg_while .ba {
    color: #4b5565;
}

.bg_while .flink:hover,
.bg_while .ba:hover {
    color: #000;
}

.bg_while .home-year-line {
    background-color: #000;
}

.bg_while .home-hero-title {
    color: #000;
}

.bg_while .home-index {
    color: #4b5565;
}

.bg_while .home-hero {
    color: #4b5565;
}

// 分类页独立使用灰阶文字，避免继承首页的蓝灰色调。
.bg_while .categories-page {
    color: #444;
}

// 次级文字与子分类计数保持同一灰度层级。
.bg_while .category-card-count,
.bg_while .category-card-post-date,
.bg_while .category-card-mark,
.bg_while .category-card-child span {
    color: #666;
}

.bg_while .category-card-title,
.bg_while .category-card-post-title {
    color: #111;
}

// 浅色主题使用半透明白色玻璃，边框与投影保持低对比。
.bg_while .glass-ambient {
    background-image:
        radial-gradient(52% 46% at 18% 10%, rgba(90, 105, 130, 0.12), transparent 72%),
        radial-gradient(44% 40% at 84% 58%, rgba(120, 110, 95, 0.08), transparent 72%);
}

.bg_while .category-card {
    border-color: rgba(20, 30, 45, 0.10);
    background-color: rgba(255, 255, 255, 0.42);
    background-image:
        radial-gradient(130% 95% at 4% 0%, rgba(255, 255, 255, 0.92), transparent 60%),
        linear-gradient(158deg, rgba(255, 255, 255, 0.72), rgba(246, 248, 252, 0.55) 55%, rgba(238, 242, 248, 0.50));
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        inset 0 -1px 0 rgba(20, 30, 45, 0.03),
        0 24px 60px rgba(20, 30, 45, 0.10);
}

.bg_while .category-card::after {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.85), transparent 45%);
}

.bg_while .category-card:hover {
    border-color: rgba(20, 30, 45, 0.20);
    background-color: rgba(255, 255, 255, 0.62);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 1),
        inset 0 -1px 0 rgba(20, 30, 45, 0.04),
        0 30px 70px rgba(20, 30, 45, 0.14);
}

// 浅色主题悬停时文字保持深色，避免继承深色主题的提亮规则。
.bg_while .category-card:hover .category-card-mark,
.bg_while .category-card:hover .category-card-more {
    color: #111;
}

.bg_while .category-card:hover .category-card-count {
    color: #444;
}

// 标签在浅色模式下只通过灰度区分常态与悬停态。
.bg_while .category-card-child {
    border-color: rgba(20, 30, 45, 0.12);
    background-color: rgba(255, 255, 255, 0.55);
    color: #555;
}

.bg_while .category-card-child:hover {
    border-color: rgba(20, 30, 45, 0.24);
    background-color: rgba(255, 255, 255, 0.85);
    color: #111;
}

.bg_while .category-card-post {
    border-bottom-color: rgba(20, 30, 45, 0.07);
}

.bg_while .category-card:hover .category-card-post {
    border-bottom-color: rgba(20, 30, 45, 0.12);
}

.bg_while .category-card-post:hover .category-card-post-title,
.bg_while .category-card-more {
    color: #111;
}

.bg_while .category-card-more {
    border-top-color: rgba(20, 30, 45, 0.10);
}

.categories-page {
    padding-bottom: 36px;
}

// 覆盖全屏的环境光层，为毛玻璃卡片提供可感知的背景明暗。
.glass-ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
        radial-gradient(52% 46% at 18% 10%, rgba(112, 130, 158, 0.16), transparent 72%),
        radial-gradient(44% 40% at 84% 58%, rgba(140, 130, 114, 0.09), transparent 72%);
}

.categories-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
}

// 毛玻璃卡片：半透明表面 + 背景模糊，保留纯黑页面的层次。
.category-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.02);
    background-image:
        radial-gradient(130% 95% at 4% 0%, rgba(255, 255, 255, 0.085), transparent 58%),
        linear-gradient(158deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.028) 55%, rgba(255, 255, 255, 0.014));
    -webkit-backdrop-filter: blur(26px) saturate(125%);
    backdrop-filter: blur(26px) saturate(125%);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.30),
        inset 0 -1px 0 rgba(255, 255, 255, 0.05),
        0 24px 60px rgba(0, 0, 0, 0.50);
    transition: border-color 0.22s cubic-bezier(0.2, 0.7, 0.3, 1), background-color 0.22s cubic-bezier(0.2, 0.7, 0.3, 1), transform 0.22s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.22s cubic-bezier(0.2, 0.7, 0.3, 1);
}

// 玻璃表面的斜向高光；内容需要盖在伪元素之上。
.category-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 42%);
    opacity: 0.85;
    pointer-events: none;
    transition: opacity 0.22s ease;
}

.category-card > * {
    position: relative;
    z-index: 1;
}

// 悬停时边框、表面与底部入口一起提亮。
.category-card:hover {
    border-color: rgba(255, 255, 255, 0.34);
    background-color: rgba(255, 255, 255, 0.05);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.38),
        inset 0 -1px 0 rgba(255, 255, 255, 0.06),
        0 30px 70px rgba(0, 0, 0, 0.55);
    transform: translateY(-5px);
}

.category-card:hover::after {
    opacity: 1;
}

.category-card:hover .category-card-mark,
.category-card:hover .category-card-more {
    color: #fff;
}

.category-card:hover .category-card-count {
    color: #ccc;
}

.category-card:hover .category-card-post {
    border-bottom-color: rgba(255, 255, 255, 0.14);
}

.category-card:hover .category-card-more span {
    transform: translateX(4px);
}

.category-card:focus-within {
    border-color: rgba(255, 255, 255, 0.28);
}

.category-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.category-card-title {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 8px;
    color: #fff;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
}

// 分类标记服从文字层次，不再成为彩色强调元素。
.category-card-mark {
    color: #aaa;
}

.category-card-count {
    flex-shrink: 0;
    color: #999;
    font-size: 12px;
    letter-spacing: 0.06em;
}

.category-card-children {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
}

// 子分类标签使用低透明度玻璃底，避免在卡片上形成黑洞。
.category-card-child {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.04);
    color: #ccc;
    font-size: 12px;
}

// 悬停标签靠文字与边框明度提供反馈。
.category-card-child:hover {
    border-color: rgba(255, 255, 255, 0.30);
    background-color: rgba(255, 255, 255, 0.08);
    color: #fff;
}

.category-card-child span {
    color: #999;
    font-size: 11px;
}

.category-card-posts {
    flex: 1;
    margin-top: 18px;
}

.category-card-post {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 0;
    // 分隔线保持低明度，避免与分类卡片外框争夺注意力。
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.category-card-post-title {
    min-width: 0;
    overflow: hidden;
    color: #ddd;
    font-size: 14px;
    line-height: 1.55;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.category-card-post-date {
    flex-shrink: 0;
    // 小字号日期使用清晰灰色，不能只降低透明度。
    color: #999;
    font-size: 11px;
    letter-spacing: 0.05em;
}

.category-card-post:hover .category-card-post-title {
    color: #fff;
}

.category-card-more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #ddd;
    font-size: 13px;
    font-weight: 600;
}

.category-card-more:hover {
    color: #fff;
}

// 键盘焦点使用链接自身的灰阶色，在两种主题下均保持清晰。
.category-card a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}

.category-card-more span {
    transition: transform 0.25s ease;
}

.category-card-more:hover span {
    transform: translateX(4px);
}

// 不支持背景模糊时回退为不透明度更高的纯色面板。
@supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .category-card,
    .category-card:hover {
        background-image: none;
        background-color: #0d0d0d;
        border-color: #3a3a3a;
    }

    .category-card:hover {
        border-color: #5a5a5a;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    }

    .bg_while .category-card,
    .bg_while .category-card:hover {
        background-image: none;
        background-color: #fafbfd;
        border-color: #d8deea;
    }

    .bg_while .category-card:hover {
        border-color: #b8c4db;
    }
}

// 尊重系统的减少动态效果偏好。
@media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card::after,
    .category-card-more span {
        transition: none;
    }

    .category-card:hover {
        transform: none;
    }

    .category-card:hover .category-card-more span {
        transform: none;
    }
}

// 移动端减少模糊半径，降低大面积 backdrop-filter 的渲染成本。
@media (max-width: 640px) {
    .category-card {
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        backdrop-filter: blur(16px) saturate(120%);
    }
}

.home-layout .home-year-title,
.home-layout-shell .home-year-title {
    margin-top: 0;
}

.home-layout .home-year-title + .home-post-link,
.home-layout-shell .home-year-title + .home-post-link {
    margin-top: 4px;
}

@media (max-width: 1100px) {
    .home-layout,
    .home-layout-shell {
        grid-template-columns: minmax(0, 190px) minmax(0, 1fr);
        gap: 24px;
    }

    .categories-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 860px) {
    .home-layout,
    .home-layout-shell {
        grid-template-columns: 1fr;
        gap: 22px;
    }

    .home-layout-sidebar {
        position: static;
    }
}

@media (max-width: 640px) {
    .home-hero {
        padding-top: 44px;
    }

    .home-hero-title {
        font-size: 34px;
    }

    .home-layout,
    .home-layout-shell {
        gap: 18px;
    }

    .home-posts-empty,
    .home-empty {
        padding: 14px;
        border-radius: 14px;
    }

    .home-post-item {
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .home-post-name {
        max-width: 100%;
        float: none;
        margin-bottom: 6px;
    }

    .home-post-time {
        float: none;
        display: block;
    }

    .categories-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .category-card {
        padding: 18px;
        border-radius: 15px;
    }

    .category-card-title {
        font-size: 20px;
    }
}
