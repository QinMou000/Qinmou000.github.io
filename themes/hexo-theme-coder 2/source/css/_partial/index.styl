.logodiv {
    text-align: center;
}

.titlex {
    font-size: 30px;
    font-weight: bold;
    margin-top: 30px;
}

.list {
    font-size: 17px;
    padding-left: 25px;
    padding-right: 25px;
    height: 30px;
    cursor: pointer;
}

.postname {
    float: left;
}

.posttime {
    float: right;
}

.logopng {
    width: 150px;
}

.breadcrumb {
    padding: 8px 15px;
    list-style: none;
    background-color: initial;
    border-radius: 0px;
    text-align: center;
}


.jing {
    color: #1E90FF;
}

.logot {
    font-weight: bold;
    font-size: 45px;
    margin-top: 10px;
    margin-bottom: -20px;
}

.logot .logo_1{
    color: #888888;
}

.logot .logo_2{
    color: #37dd2c;
}

.logot .logo_3{
    color: #be8355;
}
.words {
    padding-top: 16px;
    font-size: 20px;
}
.navd {
    padding-top: 14px;
}

.headt {
    border-bottom: 1px solid #efefef;
    height: 50px;
}

.fh {
    top: 24px;
    position: absolute;
}

hr{
    border-color: #666;
}

.home-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 56px 0 18px;
}

.home-hero-avatar {
    width: 96px;
    height: 96px;
}

.home-hero .logopng {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 1px solid #444;
    padding: 6px;
    background-color: #111;
}

.home-hero-copy {
    max-width: 640px;
}

.home-hero-title {
    margin: 0;
    font-size: 42px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    font-family: "KaiTi", "KaiTi_GB2312", "STKaiti", "Kaiti SC", "楷体", serif;
}

.home-hero-subtitle {
    margin: 14px 0 0;
    padding-top: 0;
    font-size: 16px;
    line-height: 1.9;
    color: #bbb;
    font-family: "STXingkai", "FZShuTi", "LiSu", "KaiTi", "STKaiti", "楷体", cursive;
}

.home-index {
    padding-bottom: 24px;
}

.home-layout,
.home-layout-shell {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
}

.home-layout-sidebar {
    position: sticky;
    top: 18px;
    min-width: 0;
}

.home-layout-content,
.home-posts,
.home-posts-panel {
    min-width: 0;
}

.home-load-more-shell {
    padding-top: 26px;
    text-align: center;
}

.home-load-more {
    min-width: 150px;
    padding: 11px 22px;
    border: 1px solid #555;
    border-radius: 999px;
    background-color: #111;
    color: #e7ebf5;
    font: inherit;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
}

.home-load-more:hover {
    border-color: #888;
    background-color: #1a2030;
    transform: translateY(-1px);
}

.home-load-more[hidden] {
    display: none;
}

.home-result-summary {
    margin: 12px 0 0;
    color: #8f9bb3;
    font-size: 12px;
}

.home-posts-empty,
.home-empty {
    padding: 40px 24px;
    border: 1px dashed #555;
    border-radius: 18px;
    color: #8f9bb3;
    background-color: rgba(21, 25, 34, 0.72);
    text-align: center;
}

.home-posts-empty p,
.home-empty p {
    margin: 0;
}

.home-year-title {
    margin-top: 44px;
    margin-bottom: 16px;
    font-size: 26px;
}

.home-year-title:first-child {
    margin-top: 0;
}

.home-year-title p {
    display: flex;
    align-items: center;
    margin: 0;
    color: #fff;
}

.home-year-line {
    display: inline-block;
    width: 38px;
    height: 1px;
    margin-right: 14px;
    background-color: #fff;
}

.home-post-link {
    display: block;
}

.home-post-item {
    height: auto;
    min-height: 0;
    padding: 16px 2px;
    border-bottom: 1px solid #444;
}

.home-post-link:hover .home-post-item {
    border-color: #555;
    transform: translateX(2px);
}

.home-post-name {
    max-width: calc(100% - 120px);
    font-size: 17px;
    color: #e7ebf5;
}

.home-post-time {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #999;
}

.bg_while .home-hero .logopng {
    background-color: #ffffff;
    border-color: #ddd;
}

.bg_while .home-hero-subtitle {
    color: #6b7688;
}

.bg_while .home-posts-empty,
.bg_while .home-empty {
    color: #7a8597;
}

.bg_while .home-posts-empty,
.bg_while .home-empty {
    border-color: #ddd;
    background-color: #ffffff;
}

.bg_while .home-year-title p,
.bg_while .home-post-name {
    color: #000;
}

.bg_while .home-post-item {
    border-color: #ddd;
}

.bg_while .home-post-link:hover .home-post-item {
    border-color: #b8c4db;
}

.bg_while .home-post-time {
    color: #7a8597;
}

.bg_while .home-load-more {
    border-color: #ccd2dc;
    background-color: #fff;
    color: #283345;
}

.bg_while .home-load-more:hover {
    border-color: #9aa6b8;
    background-color: #f4f6fa;
}

.bg_while .home-result-summary {
    color: #7a8597;
}

.bg_while hr {
    border-color: #ddd;
}

.bg_while .jing {
    color: #000;
}

.bg_while .logot .logo_1,
.bg_while .logot .logo_2,
.bg_while .logot .logo_3 {
    color: inherit;
}

.bg_while .titlex {
    color: #000;
}

.bg_while .list {
    color: #4b5565;
}

.bg_while .posttime {
    color: #7a8597;
}

.bg_while .postname {
    color: #000;
}

.bg_while .flink,
.bg_while .ba {
    color: #4b5565;
}

.bg_while .flink:hover,
.bg_while .ba:hover {
    color: #000;
}

.bg_while .home-year-line {
    background-color: #000;
}

.bg_while .home-hero-title {
    color: #000;
}

.bg_while .home-index {
    color: #4b5565;
}

.bg_while .home-hero {
    color: #4b5565;
}

// 分类页独立使用灰阶文字，避免继承首页的蓝灰色调。
.bg_while .categories-page {
    color: #444;
}

// 次级文字与子分类计数保持同一灰度层级。
.bg_while .category-card-count,
.bg_while .category-card-post-date,
.bg_while .category-card-mark,
.bg_while .category-card-child span {
    color: #666;
}

.bg_while .category-card-title,
.bg_while .category-card-post-title {
    color: #111;
}

// 浅色主题沿用页面白底和灰边，不使用带蓝色的投影。
.bg_while .category-card {
    border-color: #ddd;
    background-color: #fff;
}

.bg_while .category-card:hover {
    border-color: #999;
}

// 标签在浅色模式下只通过灰度区分常态与悬停态。
.bg_while .category-card-child {
    border-color: #ddd;
    background-color: #f5f5f5;
    color: #555;
}

.bg_while .category-card-child:hover {
    border-color: #999;
    background-color: #eee;
    color: #111;
}

.bg_while .category-card-post {
    border-bottom-color: #eee;
}

.bg_while .category-card-post:hover .category-card-post-title,
.bg_while .category-card-more {
    color: #111;
}

.bg_while .category-card-more {
    border-top-color: #ddd;
}

.categories-page {
    padding-bottom: 36px;
}

.categories-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
}

// 卡片与全站深色背景共用纯黑，只用灰色边线区分区域。
// 不添加阴影或有色底层，避免卡片形成独立的蓝灰面板。
.category-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px;
    border: 1px solid #333;
    border-radius: 18px;
    background-color: #000;
    transition: border-color 0.25s ease, transform 0.25s ease;
}

// 悬停只提亮边框并沿用原有位移，纯黑底色始终不变。
.category-card:hover {
    border-color: #666;
    transform: translateY(-3px);
}

.category-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.category-card-title {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 8px;
    color: #fff;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
}

// 分类标记服从文字层次，不再成为彩色强调元素。
.category-card-mark {
    color: #aaa;
}

.category-card-count {
    flex-shrink: 0;
    color: #999;
    font-size: 12px;
    letter-spacing: 0.06em;
}

.category-card-children {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
}

// 子分类标签同样使用纯黑，通过轮廓保持可点击性。
.category-card-child {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 1px solid #333;
    border-radius: 999px;
    background-color: #000;
    color: #ccc;
    font-size: 12px;
}

// 悬停标签仍为纯黑，靠文字与边框明度提供反馈。
.category-card-child:hover {
    border-color: #666;
    background-color: #000;
    color: #fff;
}

.category-card-child span {
    color: #999;
    font-size: 11px;
}

.category-card-posts {
    flex: 1;
    margin-top: 18px;
}

.category-card-post {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 0;
    // 分隔线保持低明度，避免与分类卡片外框争夺注意力。
    border-bottom: 1px solid #222;
}

.category-card-post-title {
    min-width: 0;
    overflow: hidden;
    color: #ddd;
    font-size: 14px;
    line-height: 1.55;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.category-card-post-date {
    flex-shrink: 0;
    // 小字号日期使用清晰灰色，不能只降低透明度。
    color: #999;
    font-size: 11px;
    letter-spacing: 0.05em;
}

.category-card-post:hover .category-card-post-title {
    color: #fff;
}

.category-card-more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #333;
    color: #ddd;
    font-size: 13px;
    font-weight: 600;
}

.category-card-more:hover {
    color: #fff;
}

// 键盘焦点使用链接自身的灰阶色，在两种主题下均保持清晰。
.category-card a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}

.category-card-more span {
    transition: transform 0.25s ease;
}

.category-card-more:hover span {
    transform: translateX(4px);
}

.home-layout .home-year-title,
.home-layout-shell .home-year-title {
    margin-top: 0;
}

.home-layout .home-year-title + .home-post-link,
.home-layout-shell .home-year-title + .home-post-link {
    margin-top: 4px;
}

@media (max-width: 1100px) {
    .home-layout,
    .home-layout-shell {
        grid-template-columns: minmax(0, 190px) minmax(0, 1fr);
        gap: 24px;
    }

    .categories-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 860px) {
    .home-layout,
    .home-layout-shell {
        grid-template-columns: 1fr;
        gap: 22px;
    }

    .home-layout-sidebar {
        position: static;
    }
}

@media (max-width: 640px) {
    .home-hero {
        padding-top: 44px;
    }

    .home-hero-title {
        font-size: 34px;
    }

    .home-layout,
    .home-layout-shell {
        gap: 18px;
    }

    .home-posts-empty,
    .home-empty {
        padding: 14px;
        border-radius: 14px;
    }

    .home-post-item {
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .home-post-name {
        max-width: 100%;
        float: none;
        margin-bottom: 6px;
    }

    .home-post-time {
        float: none;
        display: block;
    }

    .categories-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .category-card {
        padding: 18px;
        border-radius: 15px;
    }

    .category-card-title {
        font-size: 20px;
    }
}
