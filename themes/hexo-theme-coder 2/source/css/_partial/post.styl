.post-container {
    padding-top: 28px;
}

// 目录脱离正常文档流，悬浮在视口右侧空白区，不挤占文章宽度。
// 文章栏宽 55% 且居中，右边界位于视口 77.5% 处；目录左缘贴着文章留出 24px。
// 目录纵向居中，随内容高度自动调整，长目录只在内部滚动。
// --toc-shift 由滚轮监听脚本写入，目录在居中的基础上做轻微跟随位移。
.post-toc {
    --toc-shift: 0px;
    position: fixed;
    top: 50%;
    left: calc(77.5% + 24px);
    right: auto;
    width: calc(22.5% - 48px);
    max-width: 340px;
    max-height: calc(100vh - 112px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transform: translateY(calc(-50% + var(--toc-shift)));
    opacity: 0.9;
    transition: opacity 0.25s ease;
    z-index: 10;
    pointer-events: auto;
}

.post-toc:hover {
    opacity: 1;
}

.post-toc-title {
    flex: 0 0 auto;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.post-toc-nav {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #3a3a3a transparent;
    border-left: 2px solid #3a3a3a;
    padding-left: 16px;
}

.post-toc-nav::-webkit-scrollbar {
    width: 4px;
}

.post-toc-nav::-webkit-scrollbar-track {
    background-color: transparent;
}

.post-toc-nav::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background-color: #3a3a3a;
}

.post-toc-nav a {
    display: block;
    font-size: 14.5px;
    color: #a9a9a9;
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s;
    line-height: 1.55;
    overflow-wrap: break-word;
}

.post-toc-nav a:hover {
    color: #fff;
}

.post-toc-nav a.active {
    color: #fff;
    font-weight: 500;
}

.post-toc-nav a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
}

.post-toc-nav .toc-h2 {
    padding-left: 0;
}

.post-toc-nav .toc-h3 {
    padding-left: 14px;
}

.post-toc-nav .toc-h4 {
    padding-left: 28px;
}

.post-toc-nav .toc-h5 {
    padding-left: 42px;
}

.post-toc-nav .toc-h6 {
    padding-left: 56px;
}

.post-article {
    width: 100%;
    min-width: 0;
}

.bg_while .post-toc-title {
    color: #111;
}

.bg_while .post-toc-nav {
    border-left-color: #ddd;
    scrollbar-color: #c4c4c4 transparent;
}

.bg_while .post-toc-nav::-webkit-scrollbar-thumb {
    background-color: #c4c4c4;
}

.bg_while .post-toc-nav a {
    color: #555;
}

.bg_while .post-toc-nav a:hover,
.bg_while .post-toc-nav a.active {
    color: #000;
}

.post-page {
    padding-bottom: 30px;
}

.post-hero {
    padding: 16px 0 12px;
}

.post-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
    color: #888;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.post-meta-separator {
    color: #555;
}

.post-hero-title {
    text-align: center;
    margin-bottom: 16px;
}

.post-hero-title p {
    margin: 0;
    font-size: 38px;
    line-height: 1.35;
    color: #fff;
}

.post-hero-divider {
    margin: 0;
    border-color: #444;
}

.post-article {
    padding-top: 28px;
}

.post-article-body,
.post-content {
    width: 100%;
    height: 100%;
    margin: auto;
}

.post-content p {
    font-size: 17px;
    font-weight: 400;
}

.post-content code,
.post-content pre,
.post-content kbd,
.post-content .highlight {
    font-family: "Menlo", "Meslo LG", Consolas, monospace;
}

.post-content li {
    font-size: 16px;
    font-weight: 400;
}

.post-content a {
    font-size: inherit;
}

.post-comments-divider {
    margin-top: 34px;
    margin-bottom: 24px;
    border-color: #444;
}

.post-comments {
    padding-bottom: 10px;
}

.posts .fhr {
    margin-top: 20px;
}

.bg_while .post-meta {
    color: #666;
}

.bg_while .post-meta-separator {
    color: #999;
}

.bg_while .post-hero-title p {
    color: #000;
}

.bg_while .post-hero-divider,
.bg_while .post-comments-divider {
    border-color: #ddd;
}

.bg_while .post-content p,
.bg_while .post-content li {
    color: #111;
}

.bg_while .post-comments {
    color: #111;
}

// 右侧留白不足以放下可读的目录时隐藏，避免目录被压缩成细条。
@media screen and (max-width: 1100px) {
    .post-toc {
        display: none;
    }
}

// 手机端适配
@media screen and (max-width: 768px) {
    .post-container {
        padding-top: 20px;
    }

    .post-article {
        width: 100%;
    }

    .post-hero-title p {
        font-size: 26px;
    }

    .post-meta {
        font-size: 12px;
        gap: 8px;
    }

    .post-content p {
        font-size: 16px;
    }

    .post-content li {
        font-size: 15px;
    }

    .post-comments-divider {
        margin-top: 28px;
        margin-bottom: 20px;
    }
}
