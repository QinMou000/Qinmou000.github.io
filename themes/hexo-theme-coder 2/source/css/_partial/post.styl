.post-container {
    padding-top: 28px;
}

// 目录脱离正常文档流，悬浮在视口右侧空白区，不挤占文章宽度。
// 文章栏宽 58% 且居中，右边界位于视口 79% 处；目录左缘贴着文章留出 24px。
// 目录纵向居中，随内容高度自动调整，长目录只在内部滚动。
// --toc-shift 由滚轮监听脚本写入，目录在居中的基础上做轻微跟随位移。
.post-toc {
    --toc-shift: 0px;
    position: fixed;
    top: 50%;
    left: calc(79% + 24px);
    right: auto;
    width: calc(21% - 48px);
    max-width: 340px;
    max-height: calc(100vh - 112px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transform: translateY(calc(-50% + var(--toc-shift)));
    opacity: 0.9;
    transition: opacity 0.25s ease;
    z-index: 10;
    pointer-events: auto;
}

.post-toc:hover {
    opacity: 1;
}

.post-toc-title {
    flex: 0 0 auto;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.post-toc-nav {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    // 隐藏滚动条，由脚本把当前标题保持在可视区中间三分之一。
    scrollbar-width: none;
    -ms-overflow-style: none;
    border-left: 2px solid #3a3a3a;
    padding-left: 16px;
}

.post-toc-nav::-webkit-scrollbar {
    display: none;
}

.post-toc-list,
.post-toc-children {
    margin: 0;
    padding: 0;
    list-style: none;
}

.post-toc-nav a {
    position: relative;
    display: flex;
    align-items: flex-start;
    padding: 6px 0;
    font-size: 14px;
    color: #a9a9a9;
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.55;
}

.post-toc-nav a:hover {
    color: #fff;
}

.post-toc-nav a.active {
    color: #fff;
}

.post-toc-nav a.active::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -16px;
    width: 2px;
    background-color: #fff;
}

.post-toc-nav a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
}

// 缩进由链接的左内边距控制；三角形用负外边距放进这段留白，
// 文字始终从该级缩进位置开始，不会被展开图标推歪。
.post-toc-nav .toc-caret {
    position: relative;
    flex: 0 0 12px;
    width: 12px;
    height: 1.55em;
    margin-left: -12px;
}

.post-toc-nav .toc-link.has-children .toc-caret::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 2px;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid currentColor;
    transform: translateY(-50%);
    transition: transform 0.2s ease;
}

.post-toc-nav .toc-link.has-children[aria-expanded="true"] .toc-caret::before {
    transform: translateY(-50%) rotate(90deg);
}

.post-toc-nav .toc-text {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: break-word;
}

// 顶层字号最大，层级越深字号越小、缩进越大。
.post-toc-nav .toc-h2 {
    padding-left: 0;
    font-size: 14px;
    font-weight: 500;
    color: #cfd6e4;
}

.post-toc-nav .toc-h3 {
    padding-left: 16px;
    font-size: 13.5px;
    font-weight: 500;
    color: #b3bbc9;
}

.post-toc-nav .toc-h4 {
    padding-left: 32px;
    font-size: 13px;
    color: #a4aab5;
}

.post-toc-nav .toc-h5 {
    padding-left: 48px;
    font-size: 12.5px;
    color: #989ea8;
}

.post-toc-nav .toc-h6 {
    padding-left: 64px;
    font-size: 12px;
    color: #8d929a;
}

.post-article {
    width: 100%;
    min-width: 0;
}

.bg_while .post-toc-title {
    color: #111;
}

.bg_while .post-toc-nav {
    border-left-color: #ddd;
}

.bg_while .post-toc-nav a {
    color: #555;
}

.bg_while .post-toc-nav .toc-h2 {
    color: #222b38;
}

.bg_while .post-toc-nav .toc-h3 {
    color: #4d5866;
}

.bg_while .post-toc-nav .toc-h4 {
    color: #5c6674;
}

.bg_while .post-toc-nav .toc-h5 {
    color: #68717d;
}

.bg_while .post-toc-nav .toc-h6 {
    color: #747c87;
}

.bg_while .post-toc-nav a:hover,
.bg_while .post-toc-nav a.active {
    color: #000;
}

.bg_while .post-toc-nav a.active::before {
    background-color: #000;
}

.post-page {
    padding-bottom: 30px;
}

// 文章面板保持 58%，共享的 .hd 已扣掉毛玻璃内边距，用来和正文实际宽度对齐。
@media screen and (min-width: 801px) {
    .post-page {
        width: 58%;
    }
}


.post-hero {
    padding: 0 0 14px;
}

.post-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
    color: #888;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.post-meta-separator {
    color: #555;
}

.post-hero-title {
    text-align: center;
    margin-bottom: 16px;
}

.post-hero-title p {
    margin: 0;
    font-size: 38px;
    line-height: 1.35;
    color: #fff;
}

.post-hero-divider {
    margin: 0;
    border-color: #444;
}

// 标题区与正文共用的毛玻璃外壳；目录保持原有样式并移出外壳，避免 fixed 定位失效。
.post-shell {
    box-sizing: border-box;
    padding: 34px 40px 42px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.02);
    background-image:
        radial-gradient(130% 95% at 4% 0%, rgba(255, 255, 255, 0.085), transparent 58%),
        linear-gradient(158deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.026) 55%, rgba(255, 255, 255, 0.014));
    -webkit-backdrop-filter: blur(24px) saturate(125%);
    backdrop-filter: blur(24px) saturate(125%);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        inset 0 -1px 0 rgba(255, 255, 255, 0.05),
        0 24px 60px rgba(0, 0, 0, 0.45);
}

.post-article-body,
.post-content {
    width: 100%;
    height: 100%;
    margin: auto;
}

.post-content p {
    font-size: 17px;
    font-weight: 400;
}

.post-content code,
.post-content pre,
.post-content kbd,
.post-content .highlight {
    font-family: "Menlo", "Meslo LG", Consolas, monospace;
}

.post-content li {
    font-size: 16px;
    font-weight: 400;
}

.post-content a {
    font-size: inherit;
}

.post-comments-divider {
    margin-top: 34px;
    margin-bottom: 24px;
    border-color: #444;
}

.post-comments {
    padding-bottom: 10px;
}

.posts .fhr {
    margin-top: 20px;
}

.bg_while .post-meta {
    color: #666;
}

.bg_while .post-meta-separator {
    color: #999;
}

.bg_while .post-hero-title p {
    color: #000;
}

.bg_while .post-hero-divider,
.bg_while .post-comments-divider {
    border-color: #ddd;
}

// 深色主题正文使用比标题稍柔和的灰色；浅色主题由下方规则覆盖。
.post-content p,
.post-content li {
    color: #B8B8B8;
}

.bg_while .post-content p,
.bg_while .post-content li {
    color: #4F4F4F;
}

.bg_while .post-comments {
    color: #111;
}

// 浅色主题正文毛玻璃，沿用分类卡的浅色玻璃参数。
.bg_while .post-shell {
    border-color: rgba(20, 30, 45, 0.10);
    background-color: rgba(255, 255, 255, 0.42);
    background-image:
        radial-gradient(130% 95% at 4% 0%, rgba(255, 255, 255, 0.92), transparent 60%),
        linear-gradient(158deg, rgba(255, 255, 255, 0.72), rgba(246, 248, 252, 0.55) 55%, rgba(238, 242, 248, 0.50));
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        inset 0 -1px 0 rgba(20, 30, 45, 0.03),
        0 24px 60px rgba(20, 30, 45, 0.10);
}

// 不支持背景模糊时回退为不透明度更高的纯色面板。
@supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .post-shell {
        background-image: none;
        background-color: #0d0d0d;
        border-color: #3a3a3a;
    }

    .bg_while .post-shell {
        background-image: none;
        background-color: #fafbfd;
        border-color: #d8deea;
    }
}

// 右侧留白不足以放下可读的目录时隐藏，避免目录被压缩成细条。
@media screen and (max-width: 1100px) {
    .post-toc {
        display: none;
    }
}

// 手机端适配
@media screen and (max-width: 768px) {
    .post-container {
        padding-top: 20px;
    }

    .post-shell {
        width: 100%;
        padding: 22px 20px 28px;
        border-radius: 16px;
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        backdrop-filter: blur(16px) saturate(120%);
    }

    .post-hero-title p {
        font-size: 26px;
    }

    .post-meta {
        font-size: 12px;
        gap: 8px;
    }

    .post-content p {
        font-size: 16px;
    }

    .post-content li {
        font-size: 15px;
    }

    .post-comments-divider {
        margin-top: 28px;
        margin-bottom: 20px;
    }
}
